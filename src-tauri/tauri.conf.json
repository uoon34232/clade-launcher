{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clade Launcher",
  "version": "0.2.0",
  "identifier": "dev.clade.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clade Launcher",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "backgroundColor": "#F3EDE3",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,OptimizationHints,MediaRouter,Translate,SubresourceFilter,AutofillServerCommunication,CertificateTransparencyComponentUpdater --disk-cache-size=16777216 --media-cache-size=4194304 --js-flags=--max-old-space-size=128 --disable-background-networking --disable-component-update --disable-domain-reliability --disable-sync --disable-speech-api --no-pings",
        "create": false
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
