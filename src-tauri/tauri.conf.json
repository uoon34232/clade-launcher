{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clade Launcher",
  "version": "0.1.0",
  "identifier": "dev.clade.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clade Launcher",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "backgroundColor": "#F3EDE3",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}